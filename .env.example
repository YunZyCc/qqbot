# 机器人自己登录的 QQ（仅用于记录，可留空）
BOT_QQ=
# 唯一允许聊天的 QQ（你的号），必填
OWNER_QQ=0
# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 每天最多烧多少 token，超了她会说额度用完
DAILY_TOKEN_BUDGET=500000
# NapCat
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_WS_PATH=/onebot/v11/ws
ONEBOT_TOKEN=
# 服务
HOST=127.0.0.1
PORT=8080
# 模块
ENABLED_MODULES=chat,diary,proactive,maintenance,qzone,profile
# 记忆
SUMMARY_EVERY=10
SUMMARY_TOKEN_BUDGET=6000
EPISODE_EVERY=20
# 人格成长：攒够几次信号才真的改变自己
GROWTH_ENABLED=true
GROWTH_EVERY=10
GROWTH_PROMOTE_AFTER=3
# 日记
DIARY_ENABLED=true
DIARY_HOUR=0
DIARY_MINUTE=10
DIARY_BACKFILL_DAYS=7
DIARY_PROMPT_DAYS=3
# 向量
MEMORY_VECTOR_ENABLED=true
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16
EMBEDDING_CONCURRENCY=2
# 回复风格
REPLY_SEGMENTS_MAX=5
# 单条字数上限，0 = 不限（只按条数拆）；填 20 就是每条最多 20 字
REPLY_SEGMENT_MAX_CHARS=0
# 发几条的权重，对应 1/2/3/4/5 段。越往后越少，连发四五条是小概率
REPLY_SEGMENT_WEIGHTS=65,22,8,3,2
# 每轮发几条按权重抽：1条30% / 2条22% / 3条18% / 4条18% / 5条12%
REPLY_DELAY_ENABLED=true
REPLY_DELAY_MIN=0.5
REPLY_DELAY_MAX=1.0
# 连发多条时的间隔（秒）。发四五条就得短一点，不然节奏散
SEGMENT_INTERVAL_MIN=0.4
SEGMENT_INTERVAL_MAX=0.9
# 群聊：记录按 group:<群号> 隔离，不跟私聊混
GROUP_ENABLED=true
# 逗号分隔的群号白名单。空=不接任何群，收到群消息只打日志
GROUP_WHITELIST=1083370981
# 群里怎么叫她。命中就必回
GROUP_TRIGGER_NAMES=大肥鱼
# 没 @ 没叫名字时，插一句的概率
GROUP_REPLY_CHANCE=0.15
# 概率回复的最小间隔（秒）
GROUP_REPLY_COOLDOWN=60
# 回过话后保持对话的时长（分钟），这段时间群里说话她都会接
GROUP_ACTIVE_MINUTES=5
# 太短的消息不值得接
GROUP_MIN_CHARS=4
# 群聊回放多少条历史
GROUP_MAX_CONTEXT=40
# prompt 里最多列几个群成员
GROUP_MEMBER_LIMIT=15
# 主动开口
PROACTIVE_ENABLED=true
PROACTIVE_CHECK_MINUTES=10
PROACTIVE_DAILY_MAX=5
PROACTIVE_MIN_GAP_MINUTES=90
PROACTIVE_IDLE_MIN=30
PROACTIVE_IDLE_MAX=90
PROACTIVE_QUIET_START=0
PROACTIVE_QUIET_END=7
PROACTIVE_PROBABILITY=0.6
PROACTIVE_MISS_HOURS=6
# 被晾情绪
EMOTION_IGNORED_SULK_AFTER=2
EMOTION_SULK_HOURS=2
EMOTION_RELIEF_MINUTES=30
EMOTION_FADE_HOURS=3
# 表情包
STICKER_ENABLED=true
STICKER_DIR=data/stickers
STICKER_AUTO_RATE=0.4
STICKER_DAILY_MAX=100
STICKER_MIN_TURNS_GAP=0
STICKER_MAX_SIZE_KB=2048
STICKER_SUB_TYPE=1
# 视觉
VISION_ENABLED=true
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_API_KEY=ollama
VISION_MODEL=minicpm-v:8b
VISION_TIMEOUT=120
VISION_MAX_IMAGE_MB=5
VISION_CACHE_DAYS=7
# 联网搜索（复用 DEEPSEEK_API_KEY，不需要额外账号）
# 没用就设 SEARCH_ENABLED=false，web_search / web_fetch 两个工具不会出现在模型面前
SEARCH_ENABLED=true
SEARCH_TOP_K=5
SEARCH_DAILY_MAX=50
SEARCH_CACHE_MINUTES=60
SEARCH_TIMEOUT=15
SEARCH_FETCH_MAX_CHARS=6000

# QQ空间说说（她自己决定发，一天 1~3 条）
QZONE_ENABLED=true
QZONE_DAILY_MAX=0
QZONE_MIN_GAP_MINUTES=0
QZONE_MAX_CHARS=100
# 1 所有人可见 / 4 好友可见 / 64 仅自己可见
QZONE_VISIBILITY=1
QZONE_FALLBACK_ENABLED=false
QZONE_FALLBACK_HOUR=20
QZONE_FALLBACK_MINUTE=0
QZONE_HISTORY=5
# 个性签名（每天定时换）
SIGNATURE_ENABLED=true
SIGNATURE_HOUR=9
SIGNATURE_MINUTE=0
SIGNATURE_MAX_CHARS=30
SIGNATURE_DAILY_MAX=0
# 表情包检索（给 nekowhale 322 张建向量索引，和关键词混合）
STICKER_VECTOR_SEARCH=true
STICKER_VECTOR_WEIGHT=0.5
# 别人发的表情包自动收进图库
STICKER_AUTO_IMPORT=true
STICKER_AUTO_IMPORT_DAILY_MAX=20
STICKER_AUTO_IMPORT_MAX_KB=2048

# 好友白名单：逗号分隔的 QQ 号。你在 QQ 客户端自己加好友，加完把号填这里
# 留空 = 只有主人能聊
FRIEND_WHITELIST=
