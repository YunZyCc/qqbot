# 机器人自己登录的 QQ（仅用于记录，可留空）
BOT_QQ=
# 唯一允许聊天的 QQ（你的号），必填
OWNER_QQ=0
# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# NapCat
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_WS_PATH=/onebot/v11/ws
ONEBOT_TOKEN=
# 服务
HOST=127.0.0.1
PORT=8080
# 模块
ENABLED_MODULES=chat,diary,maintenance
# 记忆
SUMMARY_EVERY=10
SUMMARY_TOKEN_BUDGET=6000
EPISODE_EVERY=20
# 日记
DIARY_ENABLED=true
DIARY_HOUR=0
DIARY_MINUTE=10
DIARY_BACKFILL_DAYS=7
DIARY_PROMPT_DAYS=3
# 向量
MEMORY_VECTOR_ENABLED=true
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16
EMBEDDING_CONCURRENCY=2
